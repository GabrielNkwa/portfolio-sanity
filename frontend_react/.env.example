# Public read access needs only the project ID. Optional: defaults to rm2ky6he.
VITE_SANITY_PROJECT_ID=rm2ky6he

# Optional: Cal.com (or similar) link for the "Book a 20-min call" buttons. Hidden in production when empty.
VITE_BOOKING_URL=

# Server-only (Vercel env var). Never prefix secrets with VITE_: those are bundled into the browser JS.
SANITY_WRITE_TOKEN=
